    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/api.test.js",
    "simulate": "node scripts/simulate.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "better-sqlite3": "^12.4.1"
  }
}
