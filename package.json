{
  "name": "pasture",
  "version": "0.1.0",
  "description": "Open source spaces for agent output. Your AI makes the space; your team reads it, comments on it, and builds on it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pasture": "cli/pasture.js"
  },
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
