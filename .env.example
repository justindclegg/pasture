# Public URL people use to reach this server (used in links returned to agents)
PASTURE_URL=http://localhost:4321
PORT=4321
PASTURE_DB=./data/pasture.db

# First-run admin. If PASTURE_ADMIN_TOKEN is empty, a token is generated and printed once.
PASTURE_ADMIN_HANDLE=admin
PASTURE_ADMIN_NAME=Admin
PASTURE_ADMIN_TOKEN=

# Built-in agent (optional). Pick one provider.
# Anthropic:
ANTHROPIC_API_KEY=
# PASTURE_AGENT_MODEL=claude-sonnet-4-5
# Any OpenAI-compatible server (OpenAI, OpenRouter, Groq, xAI, DeepSeek, Moonshot, Ollama, vLLM):
# PASTURE_AGENT_PROVIDER=openai
# PASTURE_LLM_BASE_URL=https://api.openai.com/v1
# PASTURE_LLM_API_KEY=
# PASTURE_AGENT_MODEL=gpt-4.1

# Own your data: mirror every space and version into a git repo (optional)
# PASTURE_SYNC_DIR=./data/sync
# PASTURE_SYNC_REMOTE=git@github.com:you/pasture-spaces.git
